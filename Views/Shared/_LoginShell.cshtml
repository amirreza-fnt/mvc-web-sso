@inject IWebHostEnvironment Env
@{
    Layout = "_Layout";
    var legal = ViewData["Legal"] as string;

    var slideshowDir = System.IO.Path.Combine(Env.WebRootPath, "images", "slideshow");
    var allowed = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { ".jpg", ".jpeg", ".png", ".webp" };
    var slides = System.IO.Directory.Exists(slideshowDir)
        ? System.IO.Directory.GetFiles(slideshowDir)
            .Where(file => allowed.Contains(System.IO.Path.GetExtension(file)))
            .OrderBy(file => System.IO.Path.GetFileName(file), StringComparer.OrdinalIgnoreCase)
            .Select(file => "/images/slideshow/" + System.IO.Path.GetFileName(file))
            .ToList()
        : new List<string>();

    if (slides.Count == 0)
        slides.Add("/images/login-right.png");
}

<main class="login-page">
    <div class="login-page-bg"></div>

    <footer class="login-page-bottom">
        <img src="/images/login-bottom.png" alt="" />
        <div class="login-page-bottom-overlay"></div>
    </footer>

    <div class="login-page-center">
        <div class="login-page-wrap">
            <section class="login-card">
                <div class="login-card-media" data-slideshow>
                    <div class="login-slideshow">
                        @for (var i = 0; i < slides.Count; i++)
                        {
                            <img class="login-slideshow-slide@(i == 0 ? " is-active" : "")"
                                 src="@slides[i]"
                                 alt="" />
                        }
                    </div>

                    @if (slides.Count > 1)
                    {
                        <nav class="login-slideshow-nav" aria-label="اسلایدشو">
                            @for (var i = 0; i < slides.Count; i++)
                            {
                                <button type="button"
                                        class="login-slideshow-dot@(i == 0 ? " is-active" : "")"
                                        aria-label="اسلاید @(i + 1)"
                                        @(i == 0 ? Html.Raw("aria-current=\"true\"") : null)></button>
                            }
                        </nav>
                    }
                </div>

                <div class="login-card-body">
                    <img class="login-card-watermark" src="/images/shahrdari-typo.png" alt="شهرداری سبزوار" />

                    <header class="login-card-header">
                        <div class="login-card-brand">
                            <img class="logo" src="/images/shahrdari-logo.png" alt="لوگوی شهرداری سبزوار" />
                            <img class="wordmark" src="/images/shahrdari-word.png" alt="شهرداری سبزوار" />
                        </div>
                    </header>

                    <div class="login-card-content">
                        @RenderBody()

                        <div class="login-card-footer">
                            <p class="legal">
                                @if (!string.IsNullOrEmpty(legal))
                                {
                                    @Html.Raw(legal)
                                }
                                else
                                {
                                    <text>لطفا ابتدا <a href="#">قوانین و مقررات</a> را مطالعه نمایید</text>
                                }
                            </p>
                            <p class="version">نسخه: ۱.۰.۵</p>
                        </div>
                    </div>
                </div>
            </section>

            <div class="login-page-credit">
                <span>طراحی و توسعه در شرکت نوآوران هوشمند آرمان اسرار</span>
                <span>تابستان ۱۴۰۵ ©</span>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="/js/slideshow.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
