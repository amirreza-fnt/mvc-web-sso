@{
    ViewData["Title"] = "ورود";
    Layout = "~/Views/Shared/_LoginShell.cshtml";
}

<h1 class="step-title">ورود کاربران به پورتال</h1>
<p class="step-desc">شهروند گرامی، لطفا کد ملی خود را وارد نمایید:</p>

@if (!string.IsNullOrEmpty(ViewBag.Error as string) || !string.IsNullOrEmpty(Context.Request.Query["error"]))
{
    <div class="alert alert-error">
        @(ViewBag.Error as string ?? Context.Request.Query["error"].ToString())
    </div>
}

<form method="post" asp-controller="Account" asp-action="login" novalidate>
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

    <label class="field">
        <span class="sr-only">کد ملی</span>
        <span class="field-icon">
            <img src="/images/iran.png" alt="" />
        </span>
        <input
            class="field-input"
            type="text"
            name="melliCode"
            inputmode="numeric"
            autocomplete="off"
            maxlength="10"
            placeholder="مثال: ۰۷۸۱۲۳۴۵۶۷"
            value="@ViewBag.MelliCode"
            required />
    </label>

    <button type="submit" class="btn btn-primary">ارسال کد تایید</button>
</form>

<div class="divider">یا</div>

<a class="sso-btn"
   href="@Url.Action("redirect", "Account", new { provider = "moi", returnUrl = ViewBag.ReturnUrl })">
    <span class="sso-btn-label">
        <img src="/images/ir.png" alt="" />
        ورود از طریق پنجره دولت من
    </span>
    <span class="sso-btn-chevron">‹</span>
</a>
